# Public RPCs work for local scans. Override these if you hit rate limits.
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional explorer APIs (Blockscout-compatible by default)
# ETHEREUM_EXPLORER_API=https://eth.blockscout.com/api
# BASE_EXPLORER_API=https://base.blockscout.com/api
# ARBITRUM_EXPLORER_API=https://arbitrum.blockscout.com/api
# ROBINHOOD_EXPLORER_API=https://robinhoodchain.blockscout.com/api

# x402 — unpaid until you opt in. Bazaar lists a resource after the first settlement.
X402_REQUIRE_PAYMENT=false
X402_PAY_TO_EVM=0x0000000000000000000000000000000000000000
X402_NETWORK=eip155:8453
X402_PRICE=$0.01
